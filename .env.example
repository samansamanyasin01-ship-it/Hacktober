# ============================================================
#  CaseBoard AI — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# ── AI Provider ─────────────────────────────────────────────
# Google Gemini (OpenAI-compatible endpoint)
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_api_key_here

# ── Alternatives (comment out the block above and use one below)
# DigitalOcean Gradient Serverless Inference
# AI_PROVIDER=digitalocean
# AI_BASE_URL=https://inference.do-ai.run/v1
# AI_MODEL=llama3-8b-instruct
# AI_API_KEY=dop_v1_...

# OpenAI
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...

# Local Ollama
# AI_PROVIDER=ollama
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=llama3
# AI_API_KEY=ollama

# ── Database ────────────────────────────────────────────────
CASEBOARD_DB_PATH=/app/data/caseboard.db
